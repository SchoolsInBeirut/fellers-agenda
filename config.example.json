    { "id": 110002, "code": "MATH 210", "name": "Linear Algebra" },
    { "id": 110003, "code": "CHEM 115", "name": "General Chemistry" },
    { "id": 110004, "code": "HIST 140", "name": "Modern World History" },
    { "id": 110006, "code": "SEM 100", "name": "Department Seminar", "skip": true }
  ],

  "difficulty": {
    "PHYS 221": 5,
    "MATH 210": 4,
    "CHEM 115": 4,
    "HIST 140": 3,
    "SEM 100": 0,
    "Research": 3,
    "Mail": 2
  },

  "schedule": {
    "MATH 210": {
      "room": "LAB 110",
      "attend": true,
      "from": "2026-08-24",
      "until": "2026-12-09",
      "meets": [{ "days": ["Tue", "Thu"], "start": "13:30", "end": "14:45" }]
    },
    "PHYS 221": {
      "room": "HALL 101",
      "attend": false,
      "from": "2026-08-25",
      "until": "2026-12-10",
      "meets": [{ "days": ["Tue", "Thu"], "start": "09:00", "end": "10:15" }]
    }
  },

  "studyMinutes": {
    "weekday": 240,
    "weekend": 300,
    "weekdayWindow": ["10:30", "23:00"],
    "weekendWindow": ["10:30", "22:00"]
  },

  "leadTimeDays": {
    "exam": 7,
    "project": 5,
    "lab": 5,
    "homework": 3,
    "quiz": 2,
    "default": 3
  },

  "focus": {
    "tuning": {
      "maxBlocksPerDay": 3,
      "blockStepMinutes": 15,
      "breakMinutes": 15,
      "minBlockMinutes": 30,
      "maxBlockMinutes": 150,
      "dayStart": "08:00",
      "dayEnd": "23:00"
    }
  },

  "scrapeWindowDays": 60,
  "announcementLookbackDays": 14,

  "standardsPlan": {
    "enabled": false,
    "course": "[NOT SET]",
    "label": "Standards"
  },

  "calendars": {
    "gcal": {
      "_comment": "INBOUND: your own meetings, read into the agenda so the planner never books study over one. Off by default - it needs a calendar connector authorized in your own Claude account, and a scheduled run fetches the events itself (docs/CONFIG.md and runbooks/heavy-run.md). calendarId is what you pass that connector, usually 'primary' or the calendar's address. feed prefixes every key (lowercase letters, digits and hyphens, at most 24 characters; 'fb' is refused because that prefix already names study sessions) and label is what the page shows. skipUidSuffix is the loop guard that stops the agenda re-importing the deadlines its own ICS sink published: [NOT SET] means derive it from `namespace`, which is right unless you have renamed things. connectors.calendar.* is the OTHER direction - a sink that writes deadlines out.",
      "enabled": false,
      "calendarId": "primary",
      "feed": "calendar",
      "label": "Calendar",
      "maxEvents": 200,
      "skipUidSuffix": "[NOT SET]",
      "skipDescriptionMarker": "Auto-created by the agenda."
    }
  },

  "sideProject": {
    "enabled": false,
    "label": "Side Project",
    "provider": "github",
    "org": "[NOT SET]",
    "repos": [],
    "minDailyMinutes": 60,
    "maxDailyMinutes": 180
  },

  "connectors": {
    "lms": {
      "brightspace": {
        "enabled": true,
        "mcpServer": "brightspace",
        "package": "brightspace-mcp-server@latest"
      },
      "canvas": {
        "_comment": "baseUrl is your school's Canvas address, e.g. https://canvas.example.edu - it defaults to institution.lmsHost. token is a personal access token from Canvas > Account > Settings > New Access Token. It stays in this file, which is git-ignored, and is never logged. courseFilter limits the sweep to these course codes or ids; empty means every active enrolment.",
        "enabled": false,
        "baseUrl": "[NOT SET]",
        "token": "[NOT SET]",
        "courseFilter": []
      }
    },
    "mail": {
      "outlook": {
        "enabled": false,
        "sentItemsScan": true,
        "windowDays": 14,
        "noiseDomains": ["news.example.edu", "events.example.edu"],
        "noiseLocalParts": ["newsletter", "no-reply", "digest"],
        "keepDomains": [],
        "dropAddrs": []
      }
    },
    "calendar": {
      "outlook": { "enabled": false, "category": "Agenda", "horizonDays": 21, "maxEvents": 60 },
      "ics": { "enabled": false, "path": "data/agenda.ics" }
    },
    "board": {
      "github": { "enabled": false, "budgetMs": 60000 }
    },
    "grades": {
      "gradescope": { "enabled": false, "python": "python", "termLabel": "[NOT SET]" }
    },
    "materials": {
      "enabled": false,
      "root": "[NOT SET]",
      "categories": ["Syllabus", "Lecture Notes", "Example Problems", "Homework", "Books", "Exams", "Other"],
      "maxFileMB": 300
    }
  },

  "drive": {
    "enabled": true,
    "connectorName": "Google Drive",
    "maxEmitChars": 12000,
    "maxMirrorChars": 20000,
    "mirror": true
  },

  "artifact": { "url": "[NOT SET]" },

  "notifications": {
    "calendar": false,
    "emailDigest": "off",
    "digestTo": "[NOT SET]",
    "push": { "newAssignments": true, "dueSoonUnsubmittedHours": 48 }
  },

  "scheduler": {
    "taskPrefix": "Agenda",
    "morningAt": "07:03",
    "eveningAt": "18:07",
    "quietUntil": "07:23",
    "syncWindow": ["09:00", "23:00"],
    "syncGapHours": 3,
    "graceMinutes": 20,
    "debounceMinutes": 25,
    "maxRescuesPerLane": 2
  },

  "authRetry": {
    "_comment": "The hourly 'can we still log in?' lane. sessionFiles are checked under your home directory in order, and the first one that exists is read; an EMPTY list opts this lane out entirely, which is the right answer for a connector that keeps no session file. pushHook is an optional script run with the message as %1 and the number as %2 when a number-matching prompt appears - docs/CONFIG.md has a working one-liner.",
    "enabled": true,
    "sessionFiles": [".brightspace-mcp/session.json", ".d2l-session/session.json"],
    "minIntervalMinutes": 50,
    "pushHook": "[NOT SET]"
  }
}
