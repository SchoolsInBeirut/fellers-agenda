 import { BrowserAuthError } from "../utils/errors.js";
 import { log } from "../utils/logger.js";
-const SELECTORS = {
-    usernameInput: "input#username",
-    passwordInput: "input#password",
-    submitButton: 'button[name="_eventId_proceed"]',
-};
+
+// The previous single-sign-on form. Kept as a fallback: institutions that have
+// not migrated still serve exactly this, and removing it would break them to
+// fix someone else.
+const LEGACY = {
+    usernameInput: "input#username",
+    passwordInput: "input#password",
+    submitButton: 'button[name="_eventId_proceed"]',
+};
+
+// Microsoft Entra ID. Two steps, not one: the email field submits and is
+// REPLACED by the password field, so a single fill-both-then-submit never
+// works here.
+const ENTRA = {
+    emailInput: 'input[name="loginfmt"]',
+    passwordInput: 'input[name="passwd"]',
+    submitButton: "#idSIButton9",
+    backButton: "#idBtn_Back",
+    usernameError: "#usernameError",
+    passwordError: "#passwordError",
+    kmsiCheckbox: "#KmsiCheckboxField",
+    accountTiles: "#tilesHolder .tile, [data-test-id='accountTile']",
+};
+
+const POLL_MS = 500;
+const MFA_TIMEOUT_MS = 120000;
+
+// Which SAML identity provider to initiate against. This is institution
+// specific and must not be hardcoded: set LMS_SAML_ENTITY_ID in the server's
+// environment. When it is unset the campus selector is left alone, which is
+// the correct behaviour for a manual login.
+const SAML_ENTITY_ID = process.env.LMS_SAML_ENTITY_ID || "";
@@ -30,10 +62,10 @@ export class SSOFlow {
