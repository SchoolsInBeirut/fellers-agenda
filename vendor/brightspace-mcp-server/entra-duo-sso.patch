@@ -60,12 +97,88 @@ export class SSOFlow {
     async enterCredentials(page) {
         if (!this.config.username || !this.config.password) {
             throw new BrowserAuthError("Username and password are required for SSO login", "credentials");
         }
-        await page.fill(SELECTORS.usernameInput, this.config.username);
-        await page.fill(SELECTORS.passwordInput, this.config.password);
-        await page.click(SELECTORS.submitButton);
+        // The identity provider needs a beat to finish its client-side
+        // redirects, and WHICH form lands is not knowable in advance. Poll for
+        // whichever of the three appears rather than assuming one.
+        const deadline = Date.now() + 30000;
+        let variant = null;
+        while (Date.now() < deadline && !variant) {
+            if (await this.visible(page, ENTRA.emailInput)) variant = "entra";
+            else if (await this.visible(page, LEGACY.usernameInput)) variant = "legacy";
+            else if (await this.visible(page, ENTRA.accountTiles)) variant = "tiles";
+            else await page.waitForTimeout(POLL_MS);
+        }
+        if (!variant) {
+            // This is THE diagnostic message. "No known login form appeared" is
+            // what tells a maintainer the chain moved again, as opposed to a
+            // credential problem.
+            throw new BrowserAuthError("No known login form appeared - the identity provider's chain has changed", "credentials");
+        }
+        log("INFO", `Login form detected: ${variant}`);
+
+        if (variant === "legacy") {
+            await page.fill(LEGACY.usernameInput, this.config.username);
+            await page.fill(LEGACY.passwordInput, this.config.password);
+            await page.click(LEGACY.submitButton);
+            return;
+        }
+
+        if (variant === "tiles") {
+            // A previous account is remembered. Pick the matching tile, or fall
+            // through to the email form via "use another account".
+            const tile = page.locator(ENTRA.accountTiles, { hasText: this.config.username }).first();
+            if (await tile.isVisible({ timeout: 1000 }).catch(() => false)) {
+                log("INFO", "Selecting remembered account tile");
+                await tile.click();
+            }
+            else {
+                const other = page.locator("#otherTileText").first();
+                if (await other.isVisible({ timeout: 1000 }).catch(() => false)) await other.click();
+            }
+            await page.waitForTimeout(1000);
+        }
+
+        // Email step. May already have been skipped by a tile.
+        if (await this.visible(page, ENTRA.emailInput)) {
+            log("INFO", "Entering account email");
+            // The username is entered EXACTLY as configured. Never append a
+            // domain: whether the account is a bare name or a full address is a
+            // property of the tenant, and guessing it produces a rejection that
+            // looks like a wrong password.
+            await page.fill(ENTRA.emailInput, this.config.username);
+            await page.click(ENTRA.submitButton);
+        }
+
+        // Password step. It replaces the email field, so wait for it.
+        const pwDeadline = Date.now() + 20000;
+        let pwShown = false;
+        while (Date.now() < pwDeadline && !pwShown) {
+            if (await this.visible(page, ENTRA.usernameError)) {
+                const msg = await page.locator(ENTRA.usernameError).first().textContent().catch(() => null);
+                throw new BrowserAuthError(`CREDENTIALS-REJECTED (username): ${(msg || "").trim()}`, "credentials");
+            }
+            if (await this.visible(page, ENTRA.passwordInput)) pwShown = true;
+            else await page.waitForTimeout(POLL_MS);
+        }
+        if (!pwShown) {
+            throw new BrowserAuthError("Password field never appeared after the email step", "credentials");
+        }
+
+        log("INFO", "Entering password");
+        await page.fill(ENTRA.passwordInput, this.config.password);
+        await page.click(ENTRA.submitButton);
+
+        // Surface a wrong-password error verbatim rather than letting it time
+        // out later as an indistinguishable MFA failure.
+        await page.waitForTimeout(1500);
+        if (await this.visible(page, ENTRA.passwordError)) {
+            const msg = await page.locator(ENTRA.passwordError).first().textContent().catch(() => null);
+            throw new BrowserAuthError(`CREDENTIALS-REJECTED (password): ${(msg || "").trim()}`, "credentials");
+        }
     }
-    async handleMFA(page) {
-        await page.waitForURL(/\/d2l\/home/, { timeout: 120000 });
-    }
-    async handleStaySignedIn(page) {
-        const yes = page.locator("input[type=submit][value='Yes']").first();
-        if (await yes.isVisible().catch(() => false)) await yes.click();
-    }
+
+    /**
+     * Post-password ride: the second-factor prompt and the "stay signed in?"
+     * page, in whatever order they appear, until the LMS home page.
+     */
+    async rideToHome(page) {
+        const deadline = Date.now() + MFA_TIMEOUT_MS;
+        let pushNudged = false, trustClicked = false, kmsiClicked = false;
+        let codeLogged = false, sawSecondFactor = false;
+        log("WARN", "Waiting for approval on your phone (if a prompt is required)...");
+        while (Date.now() < deadline) {
+            const url = page.url();
+            if (url.includes("/d2l/home")) return;
+            if (url.includes("/d2l/")) {
+                await page.waitForURL(/\/d2l\/home/, { timeout: 15000 }).catch(() => {});
+                if (page.url().includes("/d2l/home")) return;
+            }
+            try {
+                if (url.includes("duosecurity.com")) {
+                    sawSecondFactor = true;
+                    // Verified Push shows a code the phone must match. Print it
+                    // or the user is staring at a phone asking for a number
+                    // that only exists on a headless browser they cannot see.
+                    if (!codeLogged) {
+                        const code = await page.locator(".verification-code, [data-testid='verification-code']").first()
+                            .textContent({ timeout: 250 }).catch(() => null);
+                        if (code && code.trim()) {
+                            log("WARN", `SECOND-FACTOR CODE: ${code.trim()} - match this on your phone`);
+                            codeLogged = true;
+                        }
+                    }
+                    // Always accept "remember this browser". That is what makes
+                    // later runs on the same persistent profile prompt-free,
+                    // which is the difference between hands-free re-auth and a
+                    // push every two hours.
+                    const trust = page.locator("#trust-browser-button").first();
+                    if (!trustClicked && (await trust.isVisible({ timeout: 250 }).catch(() => false))) {
+                        log("INFO", "Asked to trust this browser - clicking yes");
+                        await trust.click().catch(() => {});
+                        trustClicked = true;
+                    }
+                    // Nudge the push if it was not sent automatically.
+                    if (!pushNudged) {
+                        for (const sel of ["button.resend-button", "button:has-text('Send Me a Push')", "button:has-text('Try again')", "button:has-text('Send a push')"]) {
+                            const btn = page.locator(sel).first();
+                            if (await btn.isVisible({ timeout: 150 }).catch(() => false)) {
+                                log("INFO", "Requesting a push");
+                                await btn.click().catch(() => {});
+                                pushNudged = true;
+                                break;
+                            }
+                        }
+                    }
+                    const yesDevice = page.locator("button:has-text('Yes, this is my device')").first();
+                    if (await yesDevice.isVisible({ timeout: 150 }).catch(() => false)) {
+                        await yesDevice.click().catch(() => {});
+                    }
+                }
+                else if (await this.visible(page, ENTRA.kmsiCheckbox)) {
+                    if (!kmsiClicked) {
+                        log("INFO", "'Stay signed in?' - answering yes");
+                        await page.locator(ENTRA.kmsiCheckbox).first().check().catch(() => {});
+                        await page.click(ENTRA.submitButton).catch(() => {});
+                        kmsiClicked = true;
+                    }
+                }
+                else if (await this.visible(page, "input[type=submit][value='Yes']")) {
+                    await page.click("input[type=submit][value='Yes']").catch(() => {});
+                }
+                else if (await this.visible(page, ENTRA.passwordError)) {
+                    const msg = await page.locator(ENTRA.passwordError).first().textContent().catch(() => null);
+                    throw new BrowserAuthError(`CREDENTIALS-REJECTED (password): ${(msg || "").trim()}`, "credentials");
+                }
+            }
+            catch (error) {
+                if (error instanceof BrowserAuthError) throw error;
+                // A navigation raced a DOM probe. Normal during redirects.
+            }
+            await page.waitForTimeout(POLL_MS);
+        }
+        // Two different timeouts, deliberately worded differently: one means
+        // "approve the next push", the other means "the chain changed again".
+        throw new BrowserAuthError(sawSecondFactor
+            ? "MFA-TIMEOUT: the second-factor prompt was never approved within 120 seconds"
+            : "MFA-TIMEOUT: never reached the LMS home page within 120 seconds after sign-in", "mfa_approval");
+    }
 }

