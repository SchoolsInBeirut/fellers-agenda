-        log("INFO", "Starting SSO login flow");
-        await this.handleCampusSelector(page);
-        await this.enterCredentials(page);
-        await this.handleMFA(page);
-        await this.handleStaySignedIn(page);
+        log("INFO", "Starting SSO login flow (Entra + second-factor chain)");
+        await this.handleCampusSelector(page);
+        await this.enterCredentials(page);
+        // One state machine instead of separate MFA and stay-signed-in steps,
+        // because the order those two appear in genuinely varies by tenant.
+        await this.rideToHome(page);
         log("INFO", "Login successful - reached LMS home");
         return true;
     }
@@ -48,9 +80,14 @@ export class SSOFlow {
     async handleCampusSelector(page) {
         const currentUrl = page.url();
         if (currentUrl.includes("/d2l/login")) {
-            await page.click("button.campus-selector");
+            // The campus selector's buttons live inside a shadow DOM, so they
+            // cannot be clicked by selector. Navigate straight to the SAML
